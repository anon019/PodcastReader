{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["translations"],
  "properties": {
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segmentId", "translatedText"],
        "properties": {
          "segmentId": {"type": "integer"},
          "translatedText": {"type": "string"}
        }
      }
    }
  }
}
